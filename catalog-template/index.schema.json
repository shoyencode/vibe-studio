{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "entries": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id","name","description","version","protocolVersion","minVibeStudio","license","maintainer","url","sha256","size"],
      "properties": {
        "id": {"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
        "name":{"$ref":"#/$defs/text"}, "description":{"$ref":"#/$defs/text"},
        "version":{"$ref":"#/$defs/version"}, "protocolVersion":{"const":2},
        "minVibeStudio":{"$ref":"#/$defs/version"}, "license":{"$ref":"#/$defs/text"},
        "maintainer":{"$ref":"#/$defs/text"},
        "url":{"type":"string","pattern":"^https://github\\.com/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+/releases/download/kit-[a-z][a-z0-9-]*-v[0-9]+\\.[0-9]+\\.[0-9]+/[A-Za-z0-9_.-]+\\.zip$"},
        "sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "size":{"type":"integer","minimum":1,"maximum":104857600},
        "i18n":{"type":"object","propertyNames":{"pattern":"^[a-z]{2}$"},"additionalProperties":{
          "type":"object","additionalProperties":false,"properties":{"name":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"}}
        }}
      }
    }
  }
}
