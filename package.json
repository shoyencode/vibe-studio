{
  "name": "vibe-studio",
  "version": "3.0.0",
  "private": true,
  "description": "Vibe Studio: drives AI kits (skills, agents, contract) on top of Copilot, Claude, Codex or Gemini.",
  "type": "module",
  "license": "MIT",
  "vibeStudio": {
    "updates": {
      "repository": "shoyencode/vibe-studio"
    }
  },
  "exports": {
    "./project": "./core/project.mjs",
    "./copilot": "./core/adapters/copilot.mjs",
    "./markdown": "./core/markdown.mjs",
    "./i18n": "./core/i18n.mjs"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:bridge": "python -m unittest discover -s test -p \"test_*.py\"",
    "test:smoke": "node scripts/smoke.mjs",
    "test:portable": "node scripts/smoke-portable.mjs",
    "package": "node scripts/package.mjs",
    "installer:tools": "node scripts/installer/build.mjs --tools",
    "package:installer": "node scripts/installer/build.mjs",
    "test:installer": "node scripts/smoke-installer.mjs",
    "test:installer:ui": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts\\smoke-installer-ui.ps1",
    "test:installer:tools": "node scripts/smoke-installer-tools.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "optionalDependencies": {
    "@agentclientprotocol/sdk": "2.0.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@github/copilot-sdk": "1.0.22",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "41.10.7",
    "playwright-core": "^1.58.2"
  },
  "main": "app/main.mjs"
}
